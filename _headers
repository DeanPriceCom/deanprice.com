# 1. GLOBAL SECURITY POLICIES
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Reporting-Endpoints: default="/api/report"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-CgnScCePj8XJr/HDBxhAR0cRhpsg4JcEwkES2riKmBM='; style-src 'self' 'unsafe-inline'; object-src 'none'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types swPolicy 'allow-duplicates'; report-to default; report-uri /api/report;
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# 2. WASM ENGINE & EXECUTOR
/main.wasm
  X-Robots-Tag: noindex, noarchive
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate

/wasm_exec.js
  X-Robots-Tag: noindex, noarchive
  Cache-Control: public, max-age=0, must-revalidate

# 3. SERVICE WORKER (NO CACHE & NO INDEX)
/sw.js
  X-Robots-Tag: noindex, noarchive
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Content-Type: application/javascript

# 4. CACHED ASSETS (1 YEAR)
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# 5. AI & LLM DISCOVERY MANIFESTS
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate